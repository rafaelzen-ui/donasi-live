NODE_ENV=production
PORT=3000
APP_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# PostgreSQL - Railway normally provides DATABASE_URL
DATABASE_URL=

# PaymenKu
PAYMENKU_API_URL=https://api.paymenku.com
PAYMENKU_API_KEY=
PAYMENKU_WEBHOOK_SECRET=
PAYMENKU_CALLBACK_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app/api/payment/webhook

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN.up.railway.app/api/integrations/youtube/callback
